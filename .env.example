# MarketPulse AI - Environment Configuration
# Add your API keys below.
# Keep this file secure and never commit actual API keys to version control.

# Apify API Token for social media collection (LIHKG, Telegram, Naver Finance)
# Get your token at https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Exa API Key for financial news retrieval
# Get your key at https://exa.ai
EXA_API_KEY=your_exa_api_key_here

# Database URL (Default: SQLite local database; can use PostgreSQL)
# Example: postgresql://user:password@localhost:5432/marketpulse
DATABASE_URL=sqlite:///data/marketpulse.db

# Optional Model & Pipeline settings
ENVIRONMENT=development
LOG_LEVEL=INFO

